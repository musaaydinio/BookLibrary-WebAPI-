      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "sqlConnection": "Host=localhost;Database=bsStoreApp;Username=postgres;Password=YOUR_LOCAL_PASSWORD"
